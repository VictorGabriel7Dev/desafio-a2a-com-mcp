# Chave de integridade do requestState do servidor MCP (AES-256-GCM).
# >= 32 bytes de aleatoriedade, NUNCA versione o valor real (o repositorio e publico).
# Gere a sua e exporte antes de subir o servidor:
#   export REQUEST_STATE_SECRET=$(python3 -c "import secrets; print(secrets.token_hex(32))")
REQUEST_STATE_SECRET=
